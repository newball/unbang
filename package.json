{
  "name": "unbang",
  "private": true,
  "version": "0.3.3",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "test": "vitest",
    "pretest:production": "npm run build",
    "test:production": "node --test --test-reporter=spec --test-reporter=junit --test-reporter-destination=stdout --test-reporter-destination=production-test-results.xml scripts/test-production.js",
    "generate:bangs": "node scripts/generate-bangs.js",
    "prebuild": "npm run generate:bangs",
    "build": "vite build",
    "dev": "npm run generate:bangs && vite",
    "preview": "vite preview"
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "playwright": "^1.65.1",
    "vite": "^6.4.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.6"
  },
  "overrides": {
    "workbox-build": {
      "glob": "^14.0.6"
    }
  }
}
